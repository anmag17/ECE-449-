[Unit]
Description=ECE449 Detect Script – wait until Wi‑Fi truly ready
After=network.target dhcpcd.service
Requires=dhcpcd.service

[Service]
User=rpi
WorkingDirectory=/home/rpi/Desktop/ECE449/ECE-449-
# Wait until wlan0 has an IP address
ExecStartPre=/bin/bash -c 'until /sbin/ip addr show wlan0 | grep -q "inet "; do echo "Waiting for wlan0 IP..."; sleep 3; done'
ExecStart=/usr/bin/python3 /home/rpi/Desktop/ECE449/ECE-449-/detect.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target